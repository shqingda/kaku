{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kaku-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-02",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"BANGUMI_REDIRECT_URI": "https://kaku-api.shqingda.workers.dev/auth/bangumi/callback"
	},
	"triggers": {
		"crons": [
			"0 3 * * *"
		]
	},
	"kv_namespaces": [
		{
			"binding": "KAKU_CONFIG",
			"id": "cc4ad763981b4559a946072ff78c4ac8"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "kaku-production",
			"database_id": "89f314ad-9237-4c81-835e-458a4b654271",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "EXPORTS",
			"bucket_name": "kaku-exports"
		}
	],
	"observability": {
		"enabled": true
	}
}