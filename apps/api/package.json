{
  "name": "@kaku/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply kaku-production --local",
    "db:migrate:remote": "wrangler d1 migrations apply kaku-production --remote",
    "dev": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "types:worker": "wrangler types src/worker-configuration.d.ts --env-interface CloudflareBindings --include-runtime false",
    "test": "node --test tests/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test-coverage-lines=75 --test tests/*.test.mjs",
    "test:html-parsers": "node --test tests/blogs.test.mjs tests/indexes.test.mjs tests/people-browser.test.mjs tests/tags.test.mjs tests/wiki.test.mjs tests/html-parser-monitor.test.mjs tests/html-parsers.test.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kaku/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260822.1",
    "drizzle-kit": "^0.31.10",
    "miniflare": "5.20260730.0-alpha",
    "typescript": "~7.0.2",
    "wrangler": "^4.125.0"
  }
}
