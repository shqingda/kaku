# Public build-time target. This preserves the existing hosted account and data.
EXPO_PUBLIC_KAKU_API_URL=https://kaku-api.shqingda.workers.dev

# Opt in to an isolated local API explicitly; it has different accounts and data.
# EXPO_PUBLIC_KAKU_API_URL=http://127.0.0.1:8787

# iOS signing profile must match this environment; defaults: dev=sandbox, production=production.
# KAKU_APNS_ENVIRONMENT=sandbox
