{
  "name": "@kaku/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@kaku/shared": "workspace:*",
    "@sentry/react-native": "~8.28.0",
    "@shopify/flash-list": "^2.3.3",
    "@tanstack/query-async-storage-persister": "^5.105.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-persist-client": "^5.105.0",
    "expo": "~58.0.21",
    "expo-application": "~58.1.2",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-intent-launcher": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-media-library": "~58.0.13",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-quick-actions": "6.0.2",
    "expo-router": "~58.0.28",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react-native": "~14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "test-renderer": "~1.3.1",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@shopify/flash-list"
      ]
    }
  },
  "scripts": {
    "start": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} expo start --dev-client",
    "android": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} expo run:android",
    "ios": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} expo run:ios",
    "web": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:ui": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} jest",
    "test:coverage": "EXPO_PUBLIC_KAKU_API_URL=${EXPO_PUBLIC_KAKU_API_URL:-https://kaku-api.shqingda.workers.dev} node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test-coverage-lines=92 --test tests/*.test.mjs",
    "open:ios": "xcrun simctl openurl booted 'exp+kaku://expo-development-client/?url=http%3A%2F%2Flocalhost%3A8081'",
    "open:android": "adb reverse tcp:8081 tcp:8081 && adb shell am start -a android.intent.action.VIEW -d 'exp+kaku://expo-development-client/?url=http%3A%2F%2Flocalhost%3A8081'"
  },
  "private": true
}
