{
  "name": "@kaku/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "@kaku/shared": "workspace:*",
    "@sentry/react-native": "^7.11.0",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "expo": "~57.0.17",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.15",
    "expo-dev-client": "~57.0.16",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-media-library": "~57.0.4",
    "expo-network": "~57.0.1",
    "expo-quick-actions": "6.0.2",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "react": "~19.2.3",
    "react-dom": "~19.2.3",
    "react-native": "~0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "~0.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tests/*.test.mjs",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-test-coverage --test tests/*.test.mjs",
    "build:preview": "pnpm dlx eas-cli@22.2.0 build --profile preview --platform android --non-interactive --no-wait",
    "build:preview:list": "pnpm dlx eas-cli@22.2.0 build:list --platform android --limit 1",
    "build:dev": "pnpm dlx eas-cli@22.2.0 build --profile development --platform android --non-interactive --no-wait",
    "build:production": "pnpm dlx eas-cli@22.2.0 build --profile production --platform all --non-interactive --no-wait",
    "eas:whoami": "pnpm dlx eas-cli@22.2.0 whoami",
    "open:android": "adb reverse tcp:8081 tcp:8081 && adb shell am start -a android.intent.action.VIEW -d 'exp+kaku://expo-development-client/?url=http%3A%2F%2Flocalhost%3A8081'"
  },
  "private": true
}
