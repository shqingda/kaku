{
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 16.0.1"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "KAKU_OPTIMIZE_NATIVE": "1"
      }
    },
    "github": {
      "extends": "production",
      "environment": "production",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "KAKU_UPDATE_CHANNEL": "github"
      }
    }
  }
}
