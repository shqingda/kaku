{
  "name": "kaku",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kaku/api dev",
    "dev:mobile": "pnpm --filter @kaku/mobile start",
    "dev:sim": "node scripts/dev-sim.mjs",
    "dev:web": "pnpm --filter @kaku/web dev",
    "build:web": "pnpm --filter @kaku/web build",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @kaku/mobile test:ui",
    "ci:check": "bash scripts/ci-check.sh",
    "typecheck": "pnpm -r typecheck",
    "test:performance": "node --test scripts/check-performance.test.mjs",
    "test:tooling": "node --test scripts/*.test.mjs && python3 -m unittest discover -s scripts -p '*_test.py'",
    "build:android": "bash scripts/build-android.sh",
    "test:e2e": "node scripts/test-e2e.mjs"
  },
  "devDependencies": {
    "serve-sim": "0.1.48"
  }
}
