{
  "name": "kaku",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=26.5.0"
  },
  "scripts": {
    "dev:api": "pnpm --filter @kaku/api dev",
    "dev:mobile": "pnpm --filter @kaku/mobile start",
    "dev:web": "pnpm --filter @kaku/web dev",
    "build:web": "pnpm --filter @kaku/web build",
    "test": "pnpm -r test",
    "test:ui": "pnpm --filter @kaku/mobile test:ui",
    "test:smoke": "maestro test .maestro/kaku-smoke-ios.yaml",
    "test:smoke:android": "maestro test .maestro/kaku-smoke-android.yaml",
    "typecheck": "pnpm -r typecheck"
  }
}